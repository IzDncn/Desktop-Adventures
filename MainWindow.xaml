<Window x:Class="DesktopAdventures.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktop Adventures"
        Width="280" Height="200"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="Window_Loaded">

    <!-- Rechtsklick irgendwo auf Feuer/Figur: Beenden -->
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Beenden" Click="Exit_Click" />
        </ContextMenu>
    </Window.ContextMenu>

    <!-- Canvas ohne Background: transparente Bereiche bleiben klickdurchlaessig -->
    <Canvas x:Name="Scene">
        <Image x:Name="FireImage"
               RenderOptions.BitmapScalingMode="NearestNeighbor"
               Stretch="Fill" />

        <Image x:Name="CharacterImage"
               RenderOptions.BitmapScalingMode="NearestNeighbor"
               Stretch="Fill"
               Cursor="Hand"
               MouseLeftButtonDown="Character_MouseLeftButtonDown" />

        <Border x:Name="Bubble"
                Visibility="Collapsed"
                Background="#F2FFF4D6"
                BorderBrush="#FF3A2A1A"
                BorderThickness="3"
                Padding="8,4">
            <TextBlock x:Name="BubbleText"
                       FontFamily="Consolas"
                       FontSize="13"
                       FontWeight="Bold"
                       Foreground="#FF3A2A1A"
                       TextWrapping="Wrap"
                       MaxWidth="190" />
        </Border>
    </Canvas>
</Window>
